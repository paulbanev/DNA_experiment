# Production Environment Variables
# Copy this to .env and update with your actual values

# REQUIRED: Flask secret key (generate a strong random string)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_VALUE

# Flask environment
FLASK_ENV=production

# Optional: Maximum number of concurrent simulations
MAX_CONCURRENT_JOBS=10

# Optional: Custom timeout settings (in seconds)
SIMULATION_TIMEOUT=600
